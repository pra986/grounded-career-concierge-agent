# Copy to .env and fill in real credentials before running live mode
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Optional Pushover notifications for lead capture & unknown-question alerts
PUSHOVER_TOKEN=
PUSHOVER_USER=

# SQLite persistence & bounded tool loop configuration
CAREER_DB_PATH=career_concierge.db
MAX_TOOL_ROUNDS=5
